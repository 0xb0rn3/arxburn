{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arxburn",
  "version": "0.1.0",
  "identifier": "uk.arxos.arxburn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "arxburn",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Write an image to a USB stick, and prove it landed"
  }
}
